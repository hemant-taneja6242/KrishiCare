# ==========================================
# KrishiCare Environment Configuration
# ==========================================

# Application Setup
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration
# Options: sqlite | postgres | mongodb
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=krishicare
DB_USER=krishi_admin
DB_PASSWORD=krishi_secure_pass_123
DB_STORAGE=./src/db/krishicare.sqlite

# ML Inference / P1 API Service
ML_SERVICE_URL=http://localhost:5000
ML_API_KEY=krishi_ml_secret_key_2026

# Backend & Weather / P2 API Service
WEATHER_API_KEY=your_weather_api_key_here
LOCATION_GEOCODE_API_KEY=your_geocode_api_key_here

# JWT & Authentication Secrets
JWT_SECRET=krishi_care_jwt_super_secret_token_change_in_production
JWT_EXPIRES_IN=7d

# File Upload & Media Settings
UPLOAD_DIR=public/images/sample_leaves
MAX_FILE_SIZE_MB=10
